    <LangVersion>latest</LangVersion>
    <TiaV19PublicApiDirectory Condition="'$(TiaV19PublicApiDirectory)' == ''">C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19</TiaV19PublicApiDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
