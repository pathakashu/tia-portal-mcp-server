{
  "McpTransport": {
    "Port": 7443,
    "AllowInsecureLocalhost": false,
    "MaxRequestBodySizeBytes": 1048576,
    "RequestTimeoutSeconds": 30,
    "SessionDurationSeconds": 300,
    "ClientPrincipalMappings": [],
    "TrustedClientIssuers": []
  },
  "TiaV18Worker": {
    "Enabled": false,
    "EnableBlockCatalogRead": false,
    "RequestTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
